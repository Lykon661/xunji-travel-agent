# 优先在页面右上角“模型配置”接入模型（OpenAI 兼容接口或订阅登录）。
# 以下为旧配置兼容：首次加载且没有已保存配置时导入，可在页面分别选择文本和图文模型。
# BASE_URL 填兼容接口的根路径，例如 https://服务地址/v1。
TEXT_BASE_URL=
TEXT_MODEL=
TEXT_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
VISION_API_KEY=
MODEL_TIMEOUT=120

# 安装并首次登录后再启用；路径可含空格。
CRAWLER_ENABLED=false
MEDIACRAWLER_DIR=../external/MediaCrawler
MEDIACRAWLER_PYTHON=../external/MediaCrawler/.venv/Scripts/python.exe
CRAWLER_TIMEOUT=240
CRAWLER_CACHE_HOURS=24

# 优先使用指定路径或 PATH 中的 flyai；默认找不到时使用项目内安装的官方 CLI。
FLYAI_COMMAND=flyai
FLYAI_ENABLED=true
# 推荐在网页“飞猪配置”保存 API Key；未保存网页配置时使用此值。
FLYAI_API_KEY=
AMAP_API_KEY=
# 也兼容官方 Node MCP 使用的 AMAP_MAPS_API_KEY；两者只需填写一个。

# 默认在 backend/data 保存数据，仅本机单用户运行。
DATA_DIR=data
